# =============================================================================
# Gearbox Monorepo — Environment Variables
# =============================================================================
# Copy to .env.local in apps/web or apps/growth-os (or root for tooling).
# Never commit files containing real secrets.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Comma-separated allowed CORS origins (web API)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Supabase (shared across web + growth-os) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Auth & API Security ---
JWT_SECRET=
API_SECRET=
WAITLIST_API_KEY=

# --- Rate Limiting (web API) ---
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# --- Email ---
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_FROM_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
RESEND_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=

# --- Growth OS Webhooks ---
GROWTH_OS_WEBHOOK_URL=
GROWTH_OS_WEBHOOK_SECRET=

# --- Growth OS Admin ---
ADMIN_SECRET_PATH=

# --- AI (Growth OS) ---
AI_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Distributed infrastructure (all optional locally; required in AWS) ---
# Redis: distributed rate limiting, cache-aside, idempotency keys. Unset = in-memory fallback.
REDIS_URL=
# SQS: async events (outbox relay -> worker). Unset = in-process bus.
SQS_QUEUE_URL=
AWS_REGION=ap-south-1
